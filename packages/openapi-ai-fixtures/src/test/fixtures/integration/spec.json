{
  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "amount_due", "status"],
        "properties": {
          "id": { "type": "string" },
          "amount_due": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["draft", "open"] },
          "memo": { "type": "string" }
        }
      }
    }
  }
}
