{
  "openapi": "3.0.0",
  "info": {
    "title": "Studio API",
    "version": "2.1.0"
  },
  "paths": {
    "/v1/report": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices/{id}": {
      "parameters": [],
      "get": {
        "summary": "Retrieve an invoice",
        "tags": ["Invoices"],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invoice"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices": {
      "post": {
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invoice"
                }
              }
            }
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/invoice"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/inline": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "invoice": {
        "type": "object",
        "required": ["id", "amount_due", "status"],
        "properties": {
          "id": {
            "type": "string",
            "example": "in_123"
          },
          "amount_due": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "open"]
          },
          "memo": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/customer"
          }
        }
      },
      "customer": {
        "type": "object",
        "required": ["id", "address"],
        "properties": {
          "id": {
            "type": "string",
            "example": "cus_1"
          },
          "address": {
            "$ref": "#/components/schemas/address"
          }
        }
      },
      "address": {
        "type": "object",
        "required": ["city"],
        "properties": {
          "city": {
            "type": "string",
            "example": "Oslo"
          }
        }
      }
    }
  }
}
