{
  "openapi": "3.0.0",
  "info": { "title": "Fixture API", "version": "1.0.0" },
  "paths": {
    "/v1/invoices/{id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/invoice" } }
            }
          }
        }
      }
    },
    "/v1/invoices": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/invoice" } } }
            }
          }
        }
      }
    },
    "/v1/inline": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "invoice": {
        "type": "object",
        "required": ["id", "amount_due", "status"],
        "properties": {
          "id": { "type": "string", "example": "in_123" },
          "amount_due": { "type": "integer" },
          "status": { "type": "string", "enum": ["draft", "open"] },
          "memo": { "type": "string" }
        }
      }
    }
  }
}
