{
  "name": "@fixture-automation/openapi-fixture-diff",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Corrupt a fixture and diff it against its OpenAPI schema into a Missing type and stub.",
  "bin": {
    "openapi-fixture-diff": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fixture-automation/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fixture-automation/openapi-ai-fixtures": "workspace:*",
    "@fixture-automation/openapi-fixtures": "workspace:*",
    "@fixture-automation/openapi-types": "workspace:*",
    "openapi-sampler": "catalog:dependencies"
  }
}
